# Copy this file to .env.local and fill values from your Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= # Get from clerk.com dashboard
CLERK_SECRET_KEY= # Get from clerk.com dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app
NEXT_PUBLIC_SUPABASE_URL= # from Supabase dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_ANON_KEY= # from Supabase dashboard -> Settings -> API
SUPABASE_SERVICE_ROLE_KEY= # from Supabase dashboard -> Settings -> API
NEXT_PUBLIC_APP_URL= # e.g. https://invoiceflow.yourdomain.com
APP_URL= # optional server-side canonical URL
NEXT_PUBLIC_SITE_URL= # optional fallback URL
UPSTASH_REDIS_REST_URL= # optional: enables shared/distributed rate limiting
UPSTASH_REDIS_REST_TOKEN= # optional: Upstash REST token
